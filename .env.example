# For Vercel deployment or local dev against remote backend:
# Get these values from `terraform output vercel_env_local`
NEXT_PUBLIC_API_URL=https://d1234abcdef.cloudfront.net/api
NEXT_PUBLIC_WS_URL=wss://d1234abcdef.cloudfront.net/ws

# For fully local dev (both containers on your machine):
# NEXT_PUBLIC_API_URL=http://localhost:8080/api
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
